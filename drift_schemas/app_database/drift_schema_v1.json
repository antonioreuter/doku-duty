  "fixed_sql": [
    {
      "name": "notes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"notes\" (\"puzzle_id\" TEXT NOT NULL, \"cell\" INTEGER NOT NULL CHECK(\"cell\" BETWEEN 0 AND 80), \"digit\" INTEGER NOT NULL CHECK(\"digit\" BETWEEN 1 AND 9), \"kind\" TEXT NOT NULL, \"origin\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"pending_upload\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending_upload\" IN (0, 1)), PRIMARY KEY (\"puzzle_id\", \"cell\", \"digit\"));"
        }
      ]
    },
    {
      "name": "puzzle_saves",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"puzzle_saves\" (\"puzzle_id\" TEXT NOT NULL, \"placed_values\" TEXT NOT NULL, \"elapsed_ms\" INTEGER NOT NULL DEFAULT 0, \"is_complete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_complete\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, \"pending_upload\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending_upload\" IN (0, 1)), \"device_origin\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"puzzle_id\"));"
        }
      ]
    },
    {
      "name": "packs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"packs\" (\"pack_id\" TEXT NOT NULL, \"version\" INTEGER NOT NULL, \"installed_at\" TEXT NOT NULL, PRIMARY KEY (\"pack_id\"));"
        }
      ]
    },
    {
      "name": "puzzles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"puzzles\" (\"id\" TEXT NOT NULL, \"pack_id\" TEXT NOT NULL REFERENCES packs (pack_id), \"clues\" TEXT NOT NULL, \"solution\" TEXT NOT NULL, \"rank\" TEXT NOT NULL, \"seed\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "solved_puzzles",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"solved_puzzles\" (\"puzzle_id\" TEXT NOT NULL, \"solved_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"pending_upload\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending_upload\" IN (0, 1)), PRIMARY KEY (\"puzzle_id\"));"
        }
      ]
    },
    {
      "name": "lifetime_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"lifetime_stats\" (\"id\" INTEGER NOT NULL, \"puzzles_solved\" INTEGER NOT NULL DEFAULT 0, \"perfect_solves\" INTEGER NOT NULL DEFAULT 0, \"total_play_ms\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" TEXT NOT NULL, \"pending_upload\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending_upload\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "technique_stats",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"technique_stats\" (\"technique\" TEXT NOT NULL, \"puzzles_requiring\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" TEXT NOT NULL, \"pending_upload\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending_upload\" IN (0, 1)), PRIMARY KEY (\"technique\"));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"key\" TEXT NOT NULL, \"bool_value\" INTEGER NOT NULL CHECK (\"bool_value\" IN (0, 1)), \"updated_at\" TEXT NOT NULL, \"pending_upload\" INTEGER NOT NULL DEFAULT 1 CHECK (\"pending_upload\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
}